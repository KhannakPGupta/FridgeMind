# FridgeMind Backend Configuration
# Copy this file to .env and fill in your values. Never commit .env to version control.

# Google Gemini API Key (obtain free from https://aistudio.google.com/)
GEMINI_API_KEY=

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Origins allowed for CORS
CORS_ORIGINS=["http://localhost:8443","http://localhost:5173","http://localhost:3000","http://127.0.0.1:8443","http://127.0.0.1:5173"]

# Max Upload Size in Bytes (default 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760
